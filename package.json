{
    "name": "@singularity/brobot-admin-ui",
    "version": "2.0.0",
    "private": true,
    "description": "brobot's admin site: Twitch sign-in, the chat command switches, the Pokémon leaderboard, team search, the last battle, and the OBS stream overlay.",
    "scripts": {
        "dev": "ng serve --port 4207 --host 0.0.0.0",
        "build": "ng build",
        "lint": "eslint .",
        "test": "ng test --watch=false",
        "test:e2e": "playwright test --config e2e/playwright.config.ts",
        "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p e2e/tsconfig.json",
        "gen:theme": "node ../../libs/ngx-ui/scripts/generate-theme.mjs --config src/brand.config.json --out src/generated-colors.scss"
    },
    "dependencies": {
        "@angular/aria": "catalog:",
        "@angular/cdk": "catalog:",
        "@angular/common": "catalog:",
        "@angular/compiler": "catalog:",
        "@angular/core": "catalog:",
        "@angular/forms": "catalog:",
        "@angular/platform-browser": "catalog:",
        "@angular/router": "catalog:",
        "@ngx-translate/core": "^16.0.4",
        "@singularity/contracts": "workspace:*",
        "@singularity/ngx-auth": "workspace:*",
        "@singularity/ngx-ui": "workspace:*",
        "rxjs": "catalog:"
    }
}
